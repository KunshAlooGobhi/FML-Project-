# Raw/processed data is large (1M-row CSV = 127 MB) and not committed. Reproduce via manifests/.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
__pycache__/
.ipynb_checkpoints/
.venv/
*.pyc

# per-model result pickles (binary working files; the .md reports are the record)
reports/final_*_*/
reports/*.pkl
